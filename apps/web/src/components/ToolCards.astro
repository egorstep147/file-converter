---
import { t, toolPath, type Lang } from '../i18n';
import { CATEGORIES, TOOLS, type Category, type ToolSlug } from '../tools';

interface Props {
  lang: Lang;
  exclude?: string;
}
const { lang, exclude } = Astro.props;
const d = t(lang);
const BADGES: Record<ToolSlug, string> = {
  'heic-to-jpg': 'HEIC → JPG',
  'compress-image': 'JPG · PNG · WebP',
  'resize-image': 'px / %',
  'png-to-jpg': 'PNG → JPG',
  'webp-to-jpg': 'WebP → JPG',
  'jpg-to-png': 'JPG → PNG',
  'jpg-to-webp': 'JPG → WebP',
  'any-to-jpg': 'AVIF · SVG → JPG',
  'rotate-image': '↻ 90° / ⇄',
  'strip-exif': 'EXIF ✕',
  'jpg-to-pdf': 'IMG → PDF',
  'merge-pdf': 'PDF + PDF',
  'split-pdf': 'PDF / 1–3',
  'rotate-pdf': 'PDF ↻',
  'pdf-to-jpg': 'PDF → JPG',
  'pdf-to-png': 'PDF → PNG',
  'compress-pdf': 'PDF ↓ MB',
  'ogg-to-mp3': 'OGG → MP3',
  'audio-to-mp3': 'WAV · M4A → MP3',
  'zip-files': 'ZIP ⇄',
};

function catIconPath(cat: Category): string {
  switch (cat) {
    case 'image':
      return '<rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="2"/><circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/><path d="m21 15-5-5L5 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>';
    case 'pdf':
      return '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M14 2v6h6M8 13h8M8 17h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>';
    case 'audio':
      return '<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z" stroke="currentColor" stroke-width="2"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v3M8 22h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>';
    case 'archive':
      return '<rect x="3" y="4" width="18" height="4" rx="1" stroke="currentColor" stroke-width="2"/><path d="M5 8v11a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8M10 12h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>';
  }
}
---

{CATEGORIES.map((cat) => {
  const items = TOOLS.filter((x) => x.category === cat && x.slug !== exclude);
  const svgInner = catIconPath(cat);
  return (
    <div class="cat" data-cat={cat}>
      <h3>
        <span class="cat-ico" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" set:html={svgInner} />
        </span>
        <span>{d.ui.categories[cat]}</span>
        <span class="cat-count">{items.length}</span>
      </h3>
      <ul class="cards">
        {items.map((x) => (
          <li data-search={`${x.slug} ${d.tools[x.slug as ToolSlug].name} ${BADGES[x.slug as ToolSlug]}`.toLowerCase()}>
            <a href={toolPath(lang, x.slug)}>
              <span class="card-top">
                <span class="card-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" set:html={svgInner} />
                </span>
                <span class="card-badge" aria-hidden="true">{BADGES[x.slug as ToolSlug]}</span>
              </span>
              <span class="card-name">{d.tools[x.slug as ToolSlug].name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  );
})}
