---
import { DEFAULT_LANG, LANGS, homePath, t } from '../i18n';
import PwaHead from '../components/PwaHead.astro';
import '../styles/global.css';
const ui = t(DEFAULT_LANG).ui;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 — {ui.notFound}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <PwaHead />
  </head>
  <body>
    <main class="center">
      <h1>404</h1>
      <p class="lead">{ui.notFound}</p>
      <nav class="pills-404" aria-label={ui.toHome}>
        {LANGS.map((l) => <a href={homePath(l)}>{t(l).langName}</a>)}
      </nav>
    </main>
  </body>
</html>
