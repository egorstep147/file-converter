---
import { DEFAULT_LANG, HREFLANG, LANGS, t } from '../i18n';
import PwaHead from '../components/PwaHead.astro';
import '../styles/global.css';

const abs = (p: string) => new URL(p, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(DEFAULT_LANG).ui.siteName}</title>
    <meta name="description" content={t(DEFAULT_LANG).ui.homeDesc} />
    <link rel="canonical" href={abs(`/${DEFAULT_LANG}/`)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={abs(`/${l}/`)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(`/${DEFAULT_LANG}/`)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <PwaHead />
    <script is:inline define:vars={{ langs: LANGS, def: DEFAULT_LANG }}>
      // Match exact regional variants first, then 2-letter prefix, falling back to English
      var pick = (function (list) {
        for (var i = 0; i < list.length; i++) {
          var l = (list[i] || '').toLowerCase().replace(/_/g, '-');
          if (l.indexOf('zh-tw') === 0 || l.indexOf('zh-hk') === 0 || l.indexOf('zh-mo') === 0 || l.indexOf('zh-hant') === 0) return 'zh-tw';
          if (l === 'nb' || l === 'nn' || l.indexOf('nb-') === 0 || l.indexOf('nn-') === 0) return 'no';
          if (l === 'fil' || l.indexOf('fil-') === 0) return 'tl';
          if (l === 'iw' || l.indexOf('iw-') === 0) return 'he';
          if (langs.indexOf(l) !== -1) return l;
          var p = l.slice(0, 2);
          if (langs.indexOf(p) !== -1) return p;
        }
        return def;
      })(navigator.languages || [navigator.language]);
      location.replace('/' + pick + '/');
    </script>
  </head>
  <body>
    <main class="center">
      <h1>{t(DEFAULT_LANG).ui.siteName}</h1>
      <ul class="cards">
        {LANGS.map((l) => <li><a href={`/${l}/`} hreflang={HREFLANG[l]}>{t(l).langName}</a></li>)}
      </ul>
    </main>
  </body>
</html>
