# Copy to .env and fill in. Never commit .env.
# Token from @BotFather
BOT_TOKEN=
# Mini App / site address (button "Open converter")
WEBAPP_URL=https://convert.isleplace.com
# CPU-heavy conversions at the same time (VPS has 1 vCPU)
WORKERS=2
# Mini App "Send to chat" HTTP port (put Caddy/HTTPS in front of it); empty = off
API_PORT=8095
