// Cloudflare Workers static assets: the site is plain files from dist/, no server code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "local-file-converter",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Served only on our domain; the *.workers.dev copy is switched off to avoid duplicate pages in search
  "routes": [{ "pattern": "convert.isleplace.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
